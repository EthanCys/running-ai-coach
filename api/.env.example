# Copy this file to .env.local for local use. Do not commit real secrets.

# LLM backend (OpenAI-compatible)
LLM_API_KEY=your-model-api-key
LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai_compatible

# COROS MCP access token (optional — only needed when calling MCP via HTTP transport)
# In Claude Desktop / Kiro CLI the MCP server handles auth automatically.
# For standalone API server usage, paste your COROS access token here.
COROS_ACCESS_TOKEN=
